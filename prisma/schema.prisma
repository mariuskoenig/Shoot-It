generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  image                String?
  password             String?
  emailVerified        DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  phone                String?
  role                 String?
  isAdmin              Boolean               @default(false)
  isOwner              Boolean               @default(false)
  bio                  String?
  brandingColor        String?
  brandingImage        String?
  accounts             Account[]
  appointmentResponses AppointmentResponse[]
  comments             Comment[]
  signatures           ContractSignature[]
  moodboardGroups      MoodboardGroup[]      @relation("MoodboardOwner")
  participantLinks     Participant[]         @relation("UserParticipant")
  ownedProjects        Project[]             @relation("ProjectOwner")
  projectAccess        ProjectAccess[]
  applications         ProjectApplication[]
  sessions             Session[]
  imageRatings         ImageRating[]
  projectVisits        ProjectVisit[]
}

enum RegistrationMode {
  OPEN
  CLOSED
  INVITE_ONLY
}

model RegistrationSettings {
  id   String           @id @default("global")
  mode RegistrationMode @default(OPEN)
}

model RegistrationInvite {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Project {
  id                       String                 @id @default(cuid())
  name                     String
  description              String?
  date                     DateTime?
  location                 String?
  address                  String?
  shortCode                String                 @unique
  isPublic                 Boolean                @default(false)
  showMoodboardPublicly    Boolean                @default(false)
  showParticipantsPublicly Boolean                @default(false)
  showContractsPublicly    Boolean                @default(false)
  showSelectionPublicly    Boolean                @default(false)
  showSelectionFolders     Boolean                @default(true)
  allowSelectionDownload   Boolean                @default(false)
  showCallsheetPublicly    Boolean                @default(false)
  showResultsPublicly      Boolean                @default(false)
  galleryLayout            String                 @default("masonry")
  coverHidden              Boolean @default(false)
  coverPositionX           Int @default(50)
  coverPositionY           Int @default(50)
  brandingColor            String?
  brandingImage            String?
  isArchived               Boolean                @default(false)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  ownerId                  String
  allowApplications        Boolean                @default(false)
  showAppointmentsPublicly Boolean                @default(false)
  allowAppointments        Boolean                @default(false)
  allowGuestSelection      Boolean                @default(false)
  appointmentSlots         AppointmentSlot[]
  callsheet                Callsheet?
  contracts                Contract[]
  participants             Participant[]
  owner                    User                   @relation("ProjectOwner", fields: [ownerId], references: [id])
  access                   ProjectAccess[]
  applications             ProjectApplication[]
  moodboardLinks           ProjectMoodboardLink[]
  resultImages             ResultFile[]
  resultFolders            ResultFolder[]
  selectionImages          SelectionImage[]
  selectionFolders         SelectionFolder[]
  visits                   ProjectVisit[]

  @@index([shortCode])
  @@index([ownerId])
}

model ProjectAccess {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(VIEWER)
  createdAt DateTime    @default(now())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model MoodboardGroup {
  id           String                 @id @default(cuid())
  name         String
  description  String?
  isArchived   Boolean                @default(false)
  ownerId      String
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  isLibrary    Boolean                @default(false)
  isFavorite   Boolean                @default(false)
  owner        User                   @relation("MoodboardOwner", fields: [ownerId], references: [id])
  images       MoodboardImage[]
  projectLinks ProjectMoodboardLink[]

  @@index([ownerId])
}

model ProjectMoodboardLink {
  id        String          @id @default(cuid())
  projectId String
  groupId   String
  status    MoodboardStatus @default(PENDING)
  order     Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  comments  Comment[]
  group     MoodboardGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, groupId])
  @@index([projectId])
  @@index([groupId])
}

model MoodboardImage {
  id        String         @id @default(cuid())
  filename  String
  path      String
  thumbnail String?
  width     Int?
  height    Int?
  size      Int?
  isVideo   Boolean        @default(false)
  duration  Float?
  order     Int            @default(0)
  groupId   String
  createdAt DateTime       @default(now())
  group     MoodboardGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model Comment {
  id              String               @id @default(cuid())
  content         String
  moodboardLinkId String
  userId          String
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  moodboardLink   ProjectMoodboardLink @relation(fields: [moodboardLinkId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([moodboardLinkId])
}

model Participant {
  id           String             @id @default(cuid())
  name         String
  email        String?
  phone        String?
  role         String?
  notes        String?
  projectId    String
  userId       String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?              @relation("UserParticipant", fields: [userId], references: [id])
  customFields ParticipantField[]
  images       ParticipantImage[]

  @@index([projectId])
  @@index([userId])
  @@index([email])
}

model ParticipantImage {
  id            String      @id @default(cuid())
  filename      String
  path          String
  thumbnail     String?
  participantId String
  createdAt     DateTime    @default(now())
  height        Int?
  size          Int?
  width         Int?
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId])
}

model ParticipantField {
  id            String      @id @default(cuid())
  key           String
  value         String
  participantId String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, key])
}

model Contract {
  id         String              @id @default(cuid())
  title      String
  content    String
  projectId  String
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  project    Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  signatures ContractSignature[]

  @@index([projectId])
}

model ContractSignature {
  id         String   @id @default(cuid())
  contractId String
  userId     String?
  name       String
  email      String
  signature  String
  ipAddress  String?
  userAgent  String?
  signedAt   DateTime @default(now())
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([contractId])
}

model Callsheet {
  id               String                  @id @default(cuid())
  projectId        String                  @unique
  callTime         DateTime?
  startTime        DateTime?
  endTime          DateTime?
  wrapTime         DateTime?
  locationName     String?
  locationAddress  String?
  locationNotes    String?
  parkingInfo      String?
  emergencyContact String?
  emergencyPhone   String?
  weatherInfo      String?
  dresscode        String?
  equipmentList    String?
  additionalNotes  String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scheduleItems    CallsheetScheduleItem[]
}

model CallsheetScheduleItem {
  id          String    @id @default(cuid())
  callsheetId String
  time        DateTime
  duration    Int?
  activity    String
  notes       String?
  order       Int       @default(0)
  callsheet   Callsheet @relation(fields: [callsheetId], references: [id], onDelete: Cascade)

  @@index([callsheetId])
}

model SelectionImage {
  id         String            @id @default(cuid())
  filename   String
  path       String
  thumbnail  String?
  width      Int?
  height     Int?
  size       Int?
  projectId  String
  folderId   String?
  importedAt DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  folder     SelectionFolder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  ratings    ImageRating?

  @@index([projectId])
  @@index([folderId])
  @@index([filename])
}

model SelectionFolder {
  id        String           @id @default(cuid())
  name      String
  path      String           // Full logical path
  parentId  String?
  projectId String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent    SelectionFolder? @relation("SelectionSubfolders", fields: [parentId], references: [id], onDelete: Cascade)
  children  SelectionFolder[] @relation("SelectionSubfolders")
  images    SelectionImage[]

  @@index([projectId])
  @@index([parentId])
}

model ImageRating {
  id        String         @id @default(cuid())
  imageId   String         @unique
  userId    String?
  stars     Int?           @db.SmallInt
  color     RatingColor?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  guestId   String?
  image     SelectionImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("image_rating")
}

model ResultFolder {
  id        String         @id @default(cuid())
  name      String
  path      String
  parentId  String?
  projectId String
  createdAt DateTime       @default(now())
  images    ResultFile[]
  parent    ResultFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  ResultFolder[] @relation("FolderHierarchy")
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([parentId])
}

model ResultFile {
  id        String        @id @default(cuid())
  filename  String
  path      String
  thumbnail String?
  width     Int?
  height    Int?
  size      Int?
  isVideo   Boolean       @default(false)
  duration  Float?
  folderId  String?
  projectId String
  createdAt DateTime      @default(now())
  folder    ResultFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([projectId])
}

model ProjectApplication {
  id           String             @id @default(cuid())
  projectId    String
  userId       String?
  name         String?
  email        String?
  message      String?
  portfolioUrl String?
  status       ApplicationStatus  @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?
  instagramUrl String?
  role         String?
  images       ApplicationImage[]
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user         User?              @relation(fields: [userId], references: [id])

  @@index([projectId])
  @@index([userId])
}

model ApplicationImage {
  id            String             @id @default(cuid())
  filename      String
  path          String
  thumbnail     String?
  applicationId String
  createdAt     DateTime           @default(now())
  height        Int?
  size          Int?
  width         Int?
  application   ProjectApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

model AppointmentSlot {
  id        String                @id @default(cuid())
  startTime DateTime
  endTime   DateTime
  color     String?
  projectId String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  responses AppointmentResponse[]
  project   Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AppointmentResponse {
  id        String            @id @default(cuid())
  slotId    String
  userId    String
  status    AppointmentStatus @default(PENDING)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  slot      AppointmentSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slotId, userId])
  @@index([slotId])
  @@index([userId])
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum MoodboardStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum RatingColor {
  RED
  YELLOW
  GREEN
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model ProjectVisit {
  userId String
  projectId String
  openedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@index([userId, openedAt])
}

model SiteSettings {
  id String @id @default("global")
  landingImage String?
  loginImage String?
  signupImage String?
}
